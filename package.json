{
  "name": "srusti-attendance-monorepo",
  "version": "1.0.0",
  "private": true,
  "description": "Srusti Smart Attendance System - Fullstack College Attendance Platform",
  "workspaces": [
    "client",
    "server"
  ],
  "scripts": {
    "dev:server": "npm run dev --workspace=server",
    "dev:client": "npm run dev --workspace=client",
    "build:server": "npm run build --workspace=server",
    "build:client": "npm run build --workspace=client",
    "db:generate": "npm run db:generate --workspace=server",
    "db:push": "npm run db:push --workspace=server",
    "db:migrate": "npm run db:migrate --workspace=server",
    "db:seed": "npm run db:seed --workspace=server",
    "build": "npm run db:generate --workspace=server && npm run build --workspace=client",
    "vercel-build": "npm run db:generate --workspace=server && npm run build --workspace=client"
  },
  "dependencies": {
    "@prisma/client": "6.19.3",
    "argon2": "^0.45.1",
    "compression": "^1.8.2",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "csv-stringify": "^6.9.0",
    "dotenv": "^18.0.4",
    "exceljs": "^4.4.0",
    "express": "^5.2.1",
    "helmet": "^8.3.0",
    "ioredis": "^6.0.0",
    "jsonwebtoken": "^9.0.3",
    "nodemailer": "^10.0.13",
    "pdfkit": "^0.20.2",
    "pg-boss": "^12.35.0",
    "pino": "^10.3.1",
    "socket.io": "^4.8.4",
    "uuid": "^14.0.2",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/compression": "^1.8.1",
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^26.6.3",
    "@types/nodemailer": "^8.0.2",
    "@types/uuid": "^10.0.0",
    "@vercel/node": "^5.1.8",
    "prisma": "6.19.3",
    "typescript": "^5.7.0"
  }
}
