generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "rhel-openssl-3.0.x", "debian-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  TEACHER
  STUDENT
}

enum SessionStatus {
  SCHEDULED
  OPEN
  CLOSED
  FINALIZED
  CANCELLED
}

enum AttendanceStatus {
  PRESENT
  ABSENT
  LATE
}

model User {
  id                 String    @id @default(uuid())
  email              String    @unique
  name               String
  rollNo             String?   @unique
  passwordHash       String
  role               Role
  isActive           Boolean   @default(true)
  mustChangePassword Boolean   @default(true)
  failedLogins       Int       @default(0)
  lockedUntil        DateTime?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  taughtSubjects Subject[]      @relation("TeacherSubjects")
  enrollments    Enrollment[]
  attendance     Attendance[]
  refreshTokens  RefreshToken[]
  resetTokens    PasswordResetToken[]

  @@index([role])
}

model Subject {
  id        String   @id @default(uuid())
  code      String   @unique
  name      String
  teacherId String
  createdAt DateTime @default(now())

  teacher     User           @relation("TeacherSubjects", fields: [teacherId], references: [id])
  enrollments Enrollment[]
  sessions    ClassSession[]

  @@index([teacherId])
}

model Enrollment {
  studentId String
  subjectId String
  createdAt DateTime @default(now())

  student User    @relation(fields: [studentId], references: [id])
  subject Subject @relation(fields: [subjectId], references: [id])

  @@id([studentId, subjectId])
  @@index([subjectId])
}

model ClassSession {
  id             String        @id @default(uuid())
  subjectId      String
  classCode      String
  startsAt       DateTime
  endsAt         DateTime
  windowOpensAt  DateTime
  windowClosesAt DateTime
  windowExtended Boolean       @default(false)
  status         SessionStatus @default(SCHEDULED)
  finalizedAt    DateTime?
  createdById    String
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  subject    Subject      @relation(fields: [subjectId], references: [id])
  attendance Attendance[]

  @@index([subjectId, startsAt])
  @@index([classCode, status])
  @@index([status, endsAt])
}

model Attendance {
  id        String           @id @default(uuid())
  sessionId String
  studentId String
  status    AttendanceStatus
  markedAt  DateTime?
  ip        String?
  deviceId  String?
  userAgent String?

  session ClassSession @relation(fields: [sessionId], references: [id])
  student User         @relation(fields: [studentId], references: [id])

  @@unique([sessionId, studentId])
  @@index([studentId, sessionId])
  @@index([sessionId, status])
}

model RefreshToken {
  id         String    @id @default(uuid())
  userId     String
  familyId   String
  tokenHash  String    @unique
  expiresAt  DateTime
  revokedAt  DateTime?
  replacedBy String?
  createdAt  DateTime  @default(now())
  ip         String?
  userAgent  String?

  user User @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([familyId])
}

model PasswordResetToken {
  id        String    @id @default(uuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id])
}

model AuditLog {
  id        String   @id @default(uuid())
  actorId   String?
  action    String
  entity    String
  entityId  String?
  meta      Json?
  ip        String?
  createdAt DateTime @default(now())

  @@index([entity, entityId])
  @@index([actorId, createdAt])
}
